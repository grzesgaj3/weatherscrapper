# Raspberry Pi UART device. Use /dev/serial0 for the GPIO UART.
UART_PORT=/dev/serial0
UART_BAUDRATE=9600

# Full API endpoint from the Weather API README.
WEATHER_API_URL=http://localhost:5000/api/v1/measurements/
WEATHER_API_KEY=replace-with-station-api-key

HTTP_TIMEOUT=10
RETRY_DELAY=5
LOG_LEVEL=INFO
